{
  "name": "bdo-balenciaga",
  "version": "1.0.0",
  "description": "Discord bot for Black Desert Online raid/event signups",
  "main": "src/main.js",
  "bin": "src/main.js",
  "scripts": {
    "start": "node src/main.js",
    "start:lite": "node src/main.js --lite",
    "deploy": "node src/commands/deploy.js",
    "build": "node build.js",
    "test": "node --test \"test/**/*.test.js\""
  },
  "pkg": {
    "targets": [
      "node18-win-x64"
    ],
    "assets": [
      "src/desktop/TrayApp.cs",
      "icon.ico",
      "node_modules/discord.js/src/**/*",
      "node_modules/@discordjs/**/*",
      "node_modules/undici/**/*"
    ]
  },
  "dependencies": {
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^5.13.0"
  }
}
